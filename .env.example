NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-different-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-dedicated-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-dedicated-refresh-token-secret
FITBIT_OAUTH_STATE_SECRET=replace-with-a-dedicated-oauth-state-secret
FITBIT_TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-token-encryption-secret
PROVIDER_TOKEN_ENCRYPTION_KEY=replace-with-a-dedicated-provider-token-encryption-secret
FITBIT_CLIENT_ID=replace-with-fitbit-client-id
FITBIT_CLIENT_SECRET=replace-with-fitbit-client-secret
FITBIT_REDIRECT_URI=http://localhost:4000/auth/fitbit/callback
GOOGLE_HEALTH_OAUTH_STATE_SECRET=replace-with-a-dedicated-google-health-state-secret
GOOGLE_HEALTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_HEALTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_HEALTH_REDIRECT_URI=https://your-backend.example.com/auth/google-health/callback
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/fitness
